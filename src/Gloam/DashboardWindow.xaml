<Window x:Class="Gloam.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gloam"
        xmlns:vm="clr-namespace:Gloam.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Gloam - Dashboard"
        Width="1040" Height="760"
        MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource ThemeText}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <!--
        Dashboard. Component styles + theme tokens are shared:
        tokens/fonts in App.xaml, control styles in Themes/Brutalist.xaml (merged below).
        Light/dark is app-wide via App.BrutalistTheme; the title-bar toggle flips it.
        View model and bindings are unchanged.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Gloam;component/Themes/Brutalist.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Monitor-card quick control. Tag carries "is this the current value" so one
                 style serves every chip; the active chip is filled with the accent. -->
            <Style x:Key="QuickChip" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Padding" Value="7,3"/>
                <Setter Property="MinWidth" Value="38"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="face" Background="Transparent"
                                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                    <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                </Trigger>
                                <Trigger Property="Tag">
                                    <Trigger.Value>
                                        <sys:Boolean>True</sys:Boolean>
                                    </Trigger.Value>
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                    <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                    <Setter TargetName="cp" Property="TextElement.Foreground" Value="{DynamicResource ThemeOnAccent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quick controls are disabled while a calibration bypasses this display,
                 like the Configure button. -->
            <Style x:Key="QuickChipRow" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="GameLibraryRow" TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" BorderBrush="{DynamicResource ThemeBorder}"
                                    BorderThickness="1" Background="{DynamicResource ThemeBg}"
                                    Padding="9,7" Cursor="Hand" SnapsToDevicePixels="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                    <Setter TargetName="Row" Property="BorderThickness" Value="3,1,1,1"/>
                                    <Setter TargetName="Row" Property="Padding" Value="7,7,9,7"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuickLookRow" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Card" BorderBrush="{DynamicResource ThemeBorder}"
                                    BorderThickness="1" Background="{DynamicResource ThemeBg}"
                                    Padding="9,7" Cursor="Hand">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="Card" Property="Padding" Value="8,6"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource ThemeHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Monitor Template -->
            <DataTemplate DataType="{x:Type vm:DashboardItem}">
                <!-- Taller than the shared card height to fit the quick gamma/brightness rows. -->
                <Border Style="{StaticResource MonitorCard}" Height="268">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FriendlyName}" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeText}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- Calibrating: amber outline -->
                                <Border BorderBrush="{DynamicResource ThemeAmber}" BorderThickness="1" Padding="6,2" Margin="0,0,6,0"
                                        Visibility="{Binding IsCalibrating, Converter={StaticResource BoolToVis}}"
                                        ToolTip="A calibration is measuring this display; its gamma, brightness and temperature settings are bypassed until it finishes">
                                    <TextBlock Text="Calibrating" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ThemeAmber}"/>
                                </Border>
                                <!-- HDR = filled accent, SDR = outline.
                                     Defaults live in the Style (not local attributes), else the
                                     local value would beat the DataTrigger and the fill never applies. -->
                                <Border Padding="7,2" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BadgeText}" Value="HDR">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding BadgeText}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="10" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeText}" Value="HDR">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeOnAccent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Stats (faded while a calibration has this monitor's settings bypassed) -->
                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                            <Setter Property="Opacity" Value="0.35"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Gamma mode" Style="{StaticResource FieldLabel}"/>
                            <Grid Margin="0,1,0,10">
                                <TextBlock Text="{Binding CurrentGamma}" Style="{StaticResource MonoValue}" VerticalAlignment="Center"/>
                                <StackPanel x:Name="QuickGammaButtons" Style="{StaticResource QuickChipRow}">
                                    <Button Content="2.2" Style="{StaticResource QuickChip}" Tag="{Binding IsGamma22}"
                                            Command="{Binding SetGammaCommand}" CommandParameter="Gamma22"
                                            ToolTip="Apply gamma 2.2 to this display"/>
                                    <Button Content="2.4" Style="{StaticResource QuickChip}" Tag="{Binding IsGamma24}"
                                            Command="{Binding SetGammaCommand}" CommandParameter="Gamma24"
                                            ToolTip="Apply gamma 2.4 to this display"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Brightness" Style="{StaticResource FieldLabel}"/>
                            <ProgressBar Value="{Binding CurrentBrightness}" Height="6" Margin="0,3,0,3"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{Binding CurrentBrightness, StringFormat={}{0}%}" Style="{StaticResource MonoValue}" VerticalAlignment="Center"/>
                                <StackPanel x:Name="QuickBrightnessButtons" Style="{StaticResource QuickChipRow}">
                                    <Button Content="100%" Style="{StaticResource QuickChip}" Tag="{Binding IsBrightness100}"
                                            Command="{Binding SetBrightnessCommand}" CommandParameter="100"/>
                                    <Button Content="75%" Style="{StaticResource QuickChip}" Tag="{Binding IsBrightness75}"
                                            Command="{Binding SetBrightnessCommand}" CommandParameter="75"/>
                                    <Button Content="50%" Style="{StaticResource QuickChip}" Tag="{Binding IsBrightness50}"
                                            Command="{Binding SetBrightnessCommand}" CommandParameter="50"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Color temp" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding CurrentTemperatureText}" Style="{StaticResource MonoValue}" Margin="0,1,0,0"/>
                        </StackPanel>

                        <!-- Actions -->
                        <Button Grid.Row="2" Content="Configure"
                                Command="{Binding DataContext.ConfigureMonitorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BrutBtnPrimary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- App Exclusion Template -->
            <DataTemplate DataType="{x:Type vm:AppExclusionItem}">
                <!-- Night mode UI is hidden. -->
                <Border Style="{StaticResource MonitorCard}" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Night mode auto-disable" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource ThemeText}"/>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Disable night mode for" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

                            <!-- Add New (ComboBox) -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ExcludedAppPicker" IsEditable="True" ItemsSource="{Binding RunningApps}"
                                          AutomationProperties.AutomationId="ExcludedAppPicker"
                                          Text="{Binding NewAppText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource ThemeText}" AllowDrop="False">
                                    <ComboBox.Resources>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                            <Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                                <TextBlock Text="Select or type an app..." Margin="9,0,30,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource ThemeTextDim}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewAppText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button x:Name="AddExcludedAppButton" Grid.Column="1" Content="Add" Padding="14,6"
                                        AutomationProperties.AutomationId="AddExcludedApp"
                                        Command="{Binding DataContext.AddExcludedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>

                            <!-- List -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding ExcludedApps}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" Height="28" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding AppName}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                       Foreground="{DynamicResource ThemeText}"/>

                                            <CheckBox Grid.Column="1" Content="All screens" IsChecked="{Binding FullDisable}"
                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                      Foreground="{DynamicResource ThemeTextDim}" FontSize="10"
                                                      FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                                      Command="{Binding DataContext.SaveExcludedAppsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>

                                            <Button Grid.Column="2" Content="&#x2715;" Width="24" Height="24" Padding="0"
                                                    Style="{StaticResource BrutIconButton}" FontSize="13" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RemoveExcludedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeWindowFrame}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="{DynamicResource ThemeSurface}"
                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="16,0">
                    <!-- Brand -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:BrandMark Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" GapBrush="{DynamicResource ThemeSurface}"/>
                        <TextBlock Text="GLOAM" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold"
                                   FontSize="16" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                        <Border Width="1" Height="16" Background="{DynamicResource ThemeTextDim}" Opacity="0.5" Margin="12,0"/>
                        <TextBlock x:Name="WindowSectionTitle" Text="Dashboard" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                   FontSize="12" Foreground="{DynamicResource ThemeTextDim}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AppVersionLabel" Text="{Binding AppVersion}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="11" Foreground="{DynamicResource ThemeTextDim}" Opacity="0.7"
                                   VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="App version"/>
                    </StackPanel>

                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="ThemeToggleButton" Content="&#x25D0;" Width="32" Height="32"
                                Style="{StaticResource BrutIconButton}" FontSize="16"
                                ToolTip="Toggle light / dark" Click="ThemeToggle_Click"/>
                        <Button Content="&#x2715;" Width="32" Height="32"
                                Style="{StaticResource BrutIconButton}" FontSize="14"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DashboardContentStack">
                        <!-- Section header in the Game Lab style. It scrolls with the content
                             instead of staying pinned above it. -->
                        <Grid x:Name="DashboardHeader" Margin="0,0,0,10">
                            <TextBlock Text="Displays" FontFamily="{StaticResource DisplayFont}"
                                       FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeText}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed">
                                    <TextBlock Text="Night profile" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="210" Height="30"
                                              ItemsSource="{Binding AvailableNightModeAlgorithms}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedNightModeAlgorithm}"
                                              ToolTip="{Binding SelectedNightModeAlgorithmDescription}"/>
                                </StackPanel>

                                <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="11,5"/>

                                <Button Content="{Binding NightModeModeLabel}" Command="{Binding CycleNightModeCommand}"
                                        Padding="11,5" MinWidth="166" Margin="10,0,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>

                        <ItemsControl x:Name="DashboardItems" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Game Lab. Always shown (no collapse): one status strip with the
                             Automatic / Normal / Media selector, then a virtualized game library
                             beside the single Media profile editor every game shares. The
                             workspace has a fixed height because it sits in the dashboard's
                             ScrollViewer, where a star-sized row would measure to infinity and
                             defeat list virtualization for 100+ games. -->
                        <StackPanel x:Name="GameLabSection" Margin="0,24,0,0">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Game Lab" FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold" FontSize="14" Foreground="{DynamicResource ThemeText}"
                                           VerticalAlignment="Center"/>                            </Grid>

                            <Border Background="{DynamicResource ThemeSurface}"
                                    BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                    Padding="12,9" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="265"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GamerModeStateTitle}" Style="{StaticResource Kicker}"/>
                                        <TextBlock Text="{Binding GamerModeStateDetails}" FontSize="9"
                                                   Foreground="{DynamicResource ThemeTextDim}" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource ThemeBorder}" Margin="0,1,14,1"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="{Binding GamerMode.ActiveSessionSummary}"
                                                   FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{DynamicResource ThemeText}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GamerMode.ActiveSessionDetails}" FontSize="9"
                                                   Foreground="{DynamicResource ThemeTextDim}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="14"/>
                                    </StackPanel>
                                    <!-- Same choice as the `profile-set` command line (auto, normal, media).
                                         A manual choice is sticky until Automatic is chosen. -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="15,0,0,0">
                                        <TextBlock Text="PROFILE" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ProfileSelectionBox" Width="130" Margin="0,2,0,0"
                                                  ItemsSource="{Binding AvailableProfileSelections}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding ProfileSelection, Mode=TwoWay}"
                                                  ToolTip="Automatic switches to Media while a library game is active. Normal and Media stay until you choose Automatic."
                                                  AutomationProperties.AutomationId="ProfileSelection"/>
                                    </StackPanel>
                                    <!-- Only the resume action is offered: pausing is hidden, but
                                         switching paused earlier (saved in settings) needs a way back. -->
                                    <Button Grid.Column="4" Content="{Binding GamerModeToggleLabel}"
                                            Command="{Binding ToggleGamerModeCommand}"
                                            Margin="15,0,0,0"
                                            VerticalAlignment="Center" Padding="15,8"
                                            AutomationProperties.AutomationId="ToggleGamerMode">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BrutBtnPrimary}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGamerModeEnabled}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>

                            <Grid x:Name="GameLabWorkspaceHost" Height="520">
                                <!-- Normal library + single selected editor. -->
                                <Grid x:Name="LibraryWorkspace">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GamerMode.HasDiscoveryResults}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="258"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="DashboardGameLibraryPane" Grid.Column="0"
                                            BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                            Background="{DynamicResource ThemeSurface}" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Margin="2,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="YOUR GAMES" Style="{StaticResource Kicker}"/>
                                                    <TextBlock x:Name="DashboardProfileCount" Text="{Binding GamerMode.FilteredProfileCountText}"
                                                               Style="{StaticResource FieldLabel}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button x:Name="DashboardShowAllProfilesButton" Grid.Column="1"
                                                        Content="{Binding GamerMode.ShowAllProfilesLabel}"
                                                        Command="{Binding ToggleShowAllGamerProfilesCommand}"
                                                        Style="{StaticResource BrutIconButton}" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" Padding="6,3" FontSize="9" Margin="6,0,0,0"
                                                        MinWidth="48"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                                <TextBox x:Name="GameProfileSearchBox"
                                                         Text="{Binding GamerMode.ProfileSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="Search game names or executables"
                                                         AutomationProperties.Name="Search your game library"/>
                                                <TextBlock Text="Search games or executables" Margin="9,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource ThemeTextDim}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GamerMode.ProfileSearchText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding GamerMode.ProfileSearchText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <ListBox Grid.Row="2" x:Name="DashboardGameProfileList"
                                                     ItemsSource="{Binding GamerMode.FilteredProfiles}"
                                                     SelectedItem="{Binding GamerMode.SelectedProfile, Mode=TwoWay}"
                                                     Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.CanContentScroll="True"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                                     VirtualizingPanel.ScrollUnit="Pixel"
                                                     ItemContainerStyle="{StaticResource GameLibraryRow}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox x:Name="GameEnabledBox" VerticalAlignment="Center" Margin="0,0,7,0"
                                                                      IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                      ToolTip="Switch to Media while this game is active"
                                                                      AutomationProperties.Name="{Binding GameTitle}"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding GameTitle}" ToolTip="{Binding GameTitle}"
                                                                           FontFamily="{StaticResource DisplayFont}"
                                                                           FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource ThemeText}"/>
                                                                <TextBlock Text="{Binding AppName}" ToolTip="{Binding ExecutableIdentityLabel}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="9" TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextDim}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasExecutablePath}" Value="False">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeAmber}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <Button x:Name="RemoveGameButton" Grid.Column="2" Content="✕"
                                                                    Style="{StaticResource BrutIconButton}" FontSize="10"
                                                                    Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    ToolTip="Remove from library"
                                                                    Command="{Binding DataContext.RemoveGamerProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <TextBlock Grid.Row="2" Text="No games yet. Find installed games or add the game currently running."
                                                       Foreground="{DynamicResource ThemeTextDim}" FontSize="10"
                                                       TextWrapping="Wrap" Margin="2,4,2,0" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GamerMode.HasProfiles}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <TextBlock Grid.Row="3" Text="ADD A RUNNING GAME" Style="{StaticResource FieldLabel}"
                                                       Margin="2,8,0,5"/>
                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="GamerAppPicker" IsEditable="True"
                                                          ItemsSource="{Binding GamerMode.RunningApps}"
                                                          Text="{Binding GamerMode.NewAppText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="Choose a running game or type a full executable path"
                                                          AutomationProperties.AutomationId="GamerAppPicker"/>
                                                <TextBlock Text="Choose a running game" Margin="9,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource ThemeTextDim}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GamerMode.NewAppText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding GamerMode.NewAppText}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button x:Name="AddGamerProfileButton" Grid.Column="1" Content="Add"
                                                        Command="{Binding AddGamerProfileCommand}" Padding="11,7"
                                                        AutomationProperties.AutomationId="AddGamerProfile"/>
                                            </Grid>

                                            <StackPanel Grid.Row="5" Margin="0,8,0,0">
                                                <Button Content="Find installed games" Command="{Binding ScanForGamesCommand}"
                                                        AutomationProperties.AutomationId="ScanForGames">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BrutBtnSecondary}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding GamerMode.IsScanningForGames}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                    <Setter Property="Content" Value="Scanning launcher libraries…"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock Text="{Binding GamerMode.DiscoveryStatus}" FontSize="9"
                                                           Foreground="{DynamicResource ThemeTextDim}" TextWrapping="Wrap"
                                                           MaxHeight="27" Margin="2,5,2,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                            Background="{DynamicResource ThemeSurface}" Padding="14">
                                        <Grid>
                                            <!-- One editor for the Media profile. Library rows only carry identity. -->
                                            <Grid x:Name="MediaProfileEditor" DataContext="{Binding GamerMode.MediaProfile}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                                    <TextBlock Text="Media profile" FontFamily="{StaticResource DisplayFont}"
                                                               FontSize="18" FontWeight="ExtraBold"
                                                               Foreground="{DynamicResource ThemeText}"/>
                                                    <TextBlock Text="{Binding EffectSummary}" FontSize="9" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ThemeTextDim}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="Every game in your library uses these settings. Normal is each monitor's own settings."
                                                               FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource ThemeTextDim}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Row="1">
                                                    <TextBlock Text="CHOOSE A LOOK" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" Visibility="Collapsed"/>
                                                    <ListBox ItemsSource="{Binding AvailableQuickLooks}" Visibility="Collapsed"
                                                             SelectedValuePath="Value"
                                                             SelectedValue="{Binding PictureIntent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0" Padding="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ItemContainerStyle="{StaticResource QuickLookRow}">
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource DisplayFont}"
                                                                               FontWeight="Bold" FontSize="11"
                                                                               Foreground="{DynamicResource ThemeText}"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="8"
                                                                               Foreground="{DynamicResource ThemeTextDim}" Margin="0,1,0,0"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <TextBlock Text="{Binding IntentDescription}" Margin="0,6,0,0" Visibility="Collapsed"
                                                               Foreground="{DynamicResource ThemeTextDim}" FontSize="10"
                                                               TextWrapping="Wrap" MaxHeight="30"/>
                                                </StackPanel>

                                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <Grid>
                                                            <TextBlock Text="DARK-AREA VISIBILITY" Style="{StaticResource FieldLabel}"/>
                                                            <TextBlock Text="{Binding ShadowDetailPlainLabel}" HorizontalAlignment="Right"
                                                                       FontSize="9" Foreground="{DynamicResource ThemeTextDim}"/>
                                                        </Grid>
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding ShadowDetailPercent}"
                                                                TickFrequency="5" IsSnapToTickEnabled="False"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                        <Grid>
                                                            <TextBlock Text="BRIGHTNESS" Style="{StaticResource FieldLabel}"/>
                                                            <CheckBox Content="Override" HorizontalAlignment="Right"
                                                                      VerticalAlignment="Center" Margin="0,-2,0,-2"
                                                                      IsChecked="{Binding OverrideBrightness, Mode=TwoWay}"
                                                                      ToolTip="Use this brightness instead of the monitor's while Media is active."/>
                                                        </Grid>
                                                        <Slider Minimum="10" Maximum="100" Value="{Binding Brightness}"
                                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                                IsEnabled="{Binding OverrideBrightness}"/>
                                                        <TextBlock Text="{Binding BrightnessLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource ThemeTextDim}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                        <CheckBox Content="Keep this look steady while I play"
                                                                  IsChecked="{Binding GameplayLock, Mode=TwoWay}"/>
                                                        <TextBlock Text="Prevents scheduled fades until Media ends."
                                                                   Margin="24,2,0,0" FontSize="9" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource ThemeTextDim}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="3" Margin="0,10,0,0" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                                        <TextBlock Text="NIGHT WARMTH" Style="{StaticResource FieldLabel}"/>
                                                        <Slider Minimum="1900" Maximum="5000" Value="{Binding NightOpsKelvin}"
                                                                TickFrequency="100"/>
                                                        <TextBlock Text="{Binding NightOpsKelvin, StringFormat={}{0} K}" FontSize="9"
                                                                   Foreground="{DynamicResource ThemeTextDim}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="COLOR SEPARATION" Style="{StaticResource FieldLabel}"/>
                                                        <Slider Minimum="0" Maximum="100" Value="{Binding NightOpsStrengthPercent}"
                                                                TickFrequency="5"/>
                                                        <TextBlock Text="{Binding NightOpsStrengthPercent, StringFormat={}{0:F0}% preservation}" FontSize="9"
                                                                   Foreground="{DynamicResource ThemeTextDim}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Expander Grid.Row="4" Header="Advanced signal &amp; display controls"
                                                          Margin="0,9,0,0" Foreground="{DynamicResource ThemeText}"
                                                          IsExpanded="{Binding DataContext.IsGameProfileAdvancedExpanded, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                                                    <Grid x:Name="AdvancedControlsGrid" Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <CheckBox x:Name="ApplyWhileRunningBox" Grid.Row="4" Grid.ColumnSpan="8" Margin="0,9,0,0"
                                                                  Content="Stay on Media while a library game is running, even without focus"
                                                                  IsChecked="{Binding ApplyWhileRunning, Mode=TwoWay}"
                                                                  ToolTip="Use One specific display to keep Media on a chosen monitor, including when the game is minimized. A focused game takes priority; otherwise the first running game in library order is used."/>

                                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,9,0">
                                                            <TextBlock Text="EXPECTED SIGNAL" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox x:Name="AdvancedExpectedSignalBox"
                                                                      Margin="0"
                                                                      ItemsSource="{Binding AvailableHdrExpectations}" DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value" SelectedValue="{Binding HdrExpectation, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="4">
                                                            <TextBlock Text="TARGET DISPLAYS" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox x:Name="AdvancedTargetDisplaysBox"
                                                                      Margin="0"
                                                                      ItemsSource="{Binding AvailableDisplayScopes}" DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value" SelectedValue="{Binding DisplayScope, Mode=TwoWay}"
                                                                      ToolTip="With Media chosen manually there is no game window, so game-window targeting covers every display."/>
                                                        </StackPanel>

                                                        <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" Margin="0,5,0,0"
                                                                  Visibility="{Binding IsSpecificDisplay, Converter={StaticResource BoolToVis}}"
                                                                  ItemsSource="{Binding DataContext.GamerMode.AvailableDisplays, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  DisplayMemberPath="Label" SelectedValuePath="DevicePath"
                                                                  SelectedValue="{Binding MonitorDevicePath, Mode=TwoWay}"/>

                                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,7,9,0" Visibility="Collapsed">
                                                            <TextBlock Text="NIGHT BEHAVIOR" Style="{StaticResource FieldLabel}"/>
                                                            <ComboBox x:Name="AdvancedNightBehaviorBox"
                                                                      Margin="0"
                                                                      ItemsSource="{Binding AvailableNightPolicies}" DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value" SelectedValue="{Binding NightPolicy, Mode=TwoWay}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="0,7,9,0">
                                                            <Grid>
                                                                <TextBlock Text="GAMMA" Style="{StaticResource FieldLabel}"/>
                                                                <CheckBox Content="Override" HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center" Margin="0,-2,0,-2"
                                                                          IsChecked="{Binding OverrideGamma, Mode=TwoWay}"/>
                                                            </Grid>
                                                            <ComboBox x:Name="AdvancedGammaModeBox" Margin="0"
                                                                      IsEnabled="{Binding OverrideGamma}"
                                                                      ItemsSource="{Binding AvailableGammaModes}" DisplayMemberPath="Label"
                                                                      SelectedValuePath="Value" SelectedValue="{Binding GammaMode, Mode=TwoWay}">
                                                                <!-- The native Windows curve is hidden as a choice; a profile
                                                                     already on it (Cinematic HDR) still shows it as selected. -->
                                                                <ComboBox.ItemContainerStyle>
                                                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Value}" Value="WindowsDefault">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.ItemContainerStyle>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="2" Margin="0,7,9,0">
                                                            <TextBlock Text="PAPER WHITE" Style="{StaticResource FieldLabel}"/>
                                                            <TextBox x:Name="AdvancedPaperWhiteBox"
                                                                     Text="{Binding PaperWhiteNits, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="6" Grid.ColumnSpan="2" Margin="0,7,0,0">
                                                            <TextBlock Text="PEAK NITS" Style="{StaticResource FieldLabel}"/>
                                                            <TextBox x:Name="AdvancedPeakNitsBox"
                                                                     Text="{Binding PeakNits, UpdateSourceTrigger=PropertyChanged, StringFormat=F0}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,7,9,0"
                                                                    VerticalAlignment="Bottom" Visibility="Collapsed">
                                                            <TextBlock Text="NIGHT PLAY SPECTRAL LIMIT" Style="{StaticResource FieldLabel}"/>
                                                            <CheckBox Content="Use an optional melanopic ceiling"
                                                                      VerticalAlignment="Center"
                                                                      IsChecked="{Binding IsNightOpsMelanopicCeilingEnabled, Mode=TwoWay}"
                                                                      ToolTip="Off by default because a hard ceiling can alter the selected look."/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="3" Grid.Column="6" Grid.ColumnSpan="2" Margin="0,7,0,0" Visibility="Collapsed">
                                                            <TextBlock Text="MELANOPIC CEILING" Style="{StaticResource FieldLabel}"/>
                                                            <TextBox x:Name="AdvancedMelanopicCeilingBox"
                                                                     IsEnabled="{Binding IsNightOpsMelanopicCeilingEnabled}"
                                                                     Text="{Binding NightOpsMelanopicCeiling, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Expander>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Scan review replaces the workspace instead of growing the section. -->
                                <Border x:Name="GameScanPanel"
                                        BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"
                                        Background="{DynamicResource ThemeSurface}" Padding="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding GamerMode.HasDiscoveryResults}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="REVIEW FOUND GAMES" Style="{StaticResource Kicker}"/>
                                                <TextBlock Text="Choose only the games you want Gloam to recognize. Nothing is selected automatically."
                                                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                                                           Foreground="{DynamicResource ThemeText}" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding GamerMode.DiscoveryStatus}" FontSize="10"
                                                           Foreground="{DynamicResource ThemeTextDim}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Back to library"
                                                    Command="{Binding DismissGameDiscoveryCommand}"
                                                    VerticalAlignment="Center" Margin="14,0,0,0"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,10,0,8">
                                            <TextBox Text="{Binding GamerMode.DiscoverySearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Search found games"
                                                     AutomationProperties.Name="Search found games"/>
                                            <TextBlock Text="Search found games" Margin="9,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Foreground="{DynamicResource ThemeTextDim}" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GamerMode.DiscoverySearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding GamerMode.DiscoverySearchText}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <ListBox Grid.Row="2" x:Name="DiscoveredGamesList"
                                                 ItemsSource="{Binding GamerMode.FilteredDiscoveredGames}"
                                                 Background="{DynamicResource ThemeBg}" BorderBrush="{DynamicResource ThemeBorder}"
                                                 BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.CanContentScroll="True"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                    <Setter Property="Padding" Value="5,2"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,5">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AlreadyAdded}" Value="True">
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                        <Setter Property="Opacity" Value="0.55"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource DisplayFont}"
                                                                           FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ThemeText}"/>
                                                                <TextBlock Text="{Binding ExecutableName}" FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="9" Foreground="{DynamicResource ThemeTextDim}"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" Margin="18,0,2,0">
                                                                <Border BorderBrush="{DynamicResource ThemeAccent}" BorderThickness="1"
                                                                        Padding="5,2" Margin="0,0,8,0"
                                                                        Visibility="{Binding HasDetectedHdr, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="{Binding HdrEvidence}">
                                                                    <TextBlock Text="HDR FOUND" Style="{StaticResource FieldLabel}"
                                                                               Foreground="{DynamicResource ThemeAccent}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding Library}" Style="{StaticResource FieldLabel}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Grid Grid.Row="3" Margin="0,9,0,0">
                                            <TextBlock Text="Selected games can be tuned individually after they are added."
                                                       FontSize="9" Foreground="{DynamicResource ThemeTextDim}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="{Binding GamerMode.AddDiscoveredButtonLabel}"
                                                    Command="{Binding AddDiscoveredGamesCommand}"
                                                    HorizontalAlignment="Right">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource BrutBtnPrimary}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding GamerMode.IsLargeAddArmed}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Margin="2,9,2,0">
                                <TextBlock Text="{Binding GamerMode.EditorStatus}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                           Foreground="{DynamicResource ThemeTextDim}"/>                            </Grid>
                        </StackPanel>

                        <!-- Night Mode Schedule (hidden) -->
                        <Expander Margin="0,24,0,0" Visibility="Collapsed"
                                  IsExpanded="{Binding IsNightModeControlsExpanded, Mode=TwoWay}"
                                  Foreground="{DynamicResource ThemeText}">
                            <Expander.Header>
                                <TextBlock Text="Night mode controls"
                                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource ThemeText}"/>
                            </Expander.Header>
                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Margin="0,10,0,0" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Configure night mode timing, rendering, and exclusions."
                                               Foreground="{DynamicResource ThemeTextDim}" FontFamily="{StaticResource BodyFont}"
                                               Margin="0,0,0,12"/>
                                    <local:NightModeScheduleControl x:Name="ScheduleEditor"/>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Melanopic (circadian) status -->
                        <Expander x:Name="MelanopicExpander" Margin="0,24,0,0" Visibility="Collapsed"
                                  IsExpanded="{Binding IsCircadianSectionExpanded, Mode=TwoWay}"
                                  Foreground="{DynamicResource ThemeText}"
                                  Expanded="MelanopicAdvancedExpander_Expanded">
                            <Expander.Header>
                                <TextBlock Text="Circadian light (melanopic)"
                                           FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="14"
                                           Foreground="{DynamicResource ThemeText}"/>
                            </Expander.Header>
                            <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Margin="0,10,0,0" Padding="16">
                                <StackPanel>
                                    <!-- Headline: current screen melanopic light + this evening's dose,
                                         anchored to the Brown 2022 / CIE TN 015:2023 targets. -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="MELANOPIC LIGHT NOW" Style="{StaticResource Kicker}"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="ExposureBig" Text="-"
                                                           FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold"
                                                           FontSize="40" Foreground="{DynamicResource ThemeText}"/>
                                                <TextBlock Text="mel-lx" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="15" Foreground="{DynamicResource ThemeTextDim}"
                                                           VerticalAlignment="Bottom" Margin="6,0,0,7"/>
                                            </StackPanel>
                                            <TextBlock x:Name="ExposureRecommendation" FontSize="12"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       Foreground="{DynamicResource ThemeTextDim}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="THIS EVENING'S DOSE" Style="{StaticResource Kicker}" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="DoseBig" Text="-"
                                                           FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold"
                                                           FontSize="28" Foreground="{DynamicResource ThemeText}"/>
                                                <TextBlock Text="mel-lx·h" FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="13" Foreground="{DynamicResource ThemeTextDim}"
                                                           VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DoseGoal" HorizontalAlignment="Right" FontSize="11"
                                                       FontFamily="{StaticResource BodyFont}" TextAlignment="Right"
                                                       Foreground="{DynamicResource ThemeTextDim}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Advanced details hidden by default (per-monitor breakdown,
                                         spectra provenance, and the dose charts). -->
                                    <Expander x:Name="MelanopicAdvancedExpander"
                                              IsExpanded="{Binding IsCircadianAdvancedExpanded, Mode=TwoWay}"
                                              Margin="0,4,0,0"
                                              Foreground="{DynamicResource ThemeTextDim}"
                                              Expanded="MelanopicAdvancedExpander_Expanded">
                                        <Expander.Header>
                                            <TextBlock Text="Advanced information"
                                                       FontFamily="{StaticResource BodyFont}" FontSize="12"
                                                       Foreground="{DynamicResource ThemeTextDim}"/>
                                        </Expander.Header>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock x:Name="MelanopicSummary" TextWrapping="Wrap"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="13"
                                                       Foreground="{DynamicResource ThemeText}"
                                                       Text="Waiting for the first applied state."/>
                                            <TextBlock x:Name="MelanopicProvenance" TextWrapping="Wrap" FontSize="11"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       Foreground="{DynamicResource ThemeTextDim}" Margin="0,8,0,0"/>
                                            <!-- One dose chart per display. -->
                                            <StackPanel x:Name="DoseChartsPanel" Margin="0,12,0,0"
                                                        SizeChanged="DoseCanvas_SizeChanged"/>
                                            <TextBlock x:Name="DoseSummary" FontSize="11"
                                                       FontFamily="{StaticResource BodyFont}"
                                                       Foreground="{DynamicResource ThemeTextDim}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
