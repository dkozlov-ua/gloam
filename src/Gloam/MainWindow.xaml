<Window x:Class="Gloam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Gloam.ViewModels"
        Title="Gloam"
        Icon="pack://application:,,,/Gloam;component/app.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.AutomationId="Flyout">
    <!-- No caption: WindowChrome with a zero-height caption keeps the system frame (border,
         shadow, rounded corners), which WindowStyle="None" loses. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- A tray flyout in the manner of G-Helper: opens by the notification area, closes when it
         loses focus, and holds every setting. Each change is saved and applied at once. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="16,14,12,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Click="Hide_Click"
                    ToolTip="Close (Esc)" AutomationProperties.Name="Close" AutomationProperties.AutomationId="Close" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding Update.Version}" Style="{StaticResource Caption}" Margin="0,0,6,0"
                       AutomationProperties.AutomationId="Version" />
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Gloam;component/app.ico" Width="22" Height="22" Margin="0,0,10,0" />
                <TextBlock Text="Gloam" Style="{StaticResource PageTitle}" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,0,12,0">
            <StackPanel>
                <!-- Profile -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8AB;" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProfileDetail}" Style="{StaticResource SectionStatus}"
                                       AutomationProperties.AutomationId="ProfileDetail" />
                            <TextBlock Text="Profile" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <UniformGrid Columns="3" Margin="0,0,-8,0">
                            <RadioButton Style="{StaticResource ModeButton}" GroupName="Profile" IsChecked="{Binding IsNormal}"
                                         AutomationProperties.Name="Normal" AutomationProperties.AutomationId="ProfileNormal">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModeLabel}" Text="Normal" />
                                    <TextBlock Style="{StaticResource ModeHint}" Text="HDR" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ModeButton}" GroupName="Profile" IsChecked="{Binding IsMedia}"
                                         AutomationProperties.Name="Media" AutomationProperties.AutomationId="ProfileMedia">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModeLabel}" Text="Media" />
                                    <TextBlock Style="{StaticResource ModeHint}" Text="{Binding Media.Summary}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Media.Summary}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ModeButton}" GroupName="Profile" IsChecked="{Binding IsSdr}"
                                         AutomationProperties.Name="SDR" AutomationProperties.AutomationId="ProfileSdr">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource ModeLabel}" Text="SDR" />
                                    <TextBlock Style="{StaticResource ModeHint}" Text="HDR off" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Display -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" Width="30" Height="28"
                                    Command="{Binding RefreshCommand}" ToolTip="Find displays again"
                                    AutomationProperties.Name="Refresh displays" AutomationProperties.AutomationId="RefreshDisplays" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedMonitor.Signal}" Style="{StaticResource SectionStatus}"
                                       AutomationProperties.AutomationId="DisplaySignal" />
                            <TextBlock Text="Display" Style="{StaticResource CardTitle}" />
                        </DockPanel>

                        <TextBlock Text="No displays were found." Style="{StaticResource Detail}"
                                   Visibility="{Binding HasMonitors, Converter={StaticResource InverseBoolToVisibility}}" />

                        <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Title"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                  Visibility="{Binding HasSeveralMonitors, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Display" AutomationProperties.AutomationId="DisplayPicker" />

                        <StackPanel DataContext="{Binding SelectedMonitor}"
                                    Visibility="{Binding DataContext.HasMonitors, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Visibility="{Binding DataContext.HasSeveralMonitors, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVisibility}}"
                                       AutomationProperties.AutomationId="DisplayTitle" />

                            <TextBlock Text="Gamma" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,-8,12">
                                <RadioButton Style="{StaticResource ModeButton}" GroupName="DisplayGamma" IsChecked="{Binding IsGamma22}"
                                             AutomationProperties.Name="Gamma 2.2" AutomationProperties.AutomationId="DisplayGamma22">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModeLabel}" Text="2.2" />
                                        <TextBlock Style="{StaticResource ModeHint}" Text="Everyday" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ModeButton}" GroupName="DisplayGamma" IsChecked="{Binding IsGamma24}"
                                             AutomationProperties.Name="Gamma 2.4" AutomationProperties.AutomationId="DisplayGamma24">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ModeLabel}" Text="2.4" />
                                        <TextBlock Style="{StaticResource ModeHint}" Text="Dark room" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding BrightnessText}" Style="{StaticResource Caption}"
                                           AutomationProperties.AutomationId="DisplayBrightnessText" />
                                <TextBlock Text="Brightness" Style="{StaticResource Caption}" />
                            </DockPanel>
                            <Slider Minimum="10" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                    Value="{Binding Brightness, Delay=150}" Margin="0,4,0,0"
                                    AutomationProperties.Name="Brightness" AutomationProperties.AutomationId="DisplayBrightness" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasMediaNote, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE946;" />
                                <TextBlock Text="{Binding MediaNote}" Style="{StaticResource Detail}" MaxWidth="340"
                                           AutomationProperties.AutomationId="DisplayMediaNote" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Media profile -->
                <Border Style="{StaticResource Card}" DataContext="{Binding Media}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B2;" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource SectionStatus}"
                                       AutomationProperties.AutomationId="MediaSummary" />
                            <TextBlock Text="Media profile" Style="{StaticResource CardTitle}" />
                        </DockPanel>
                        <TextBlock Text="Changes these on top of each display's settings while Media is on."
                                   Style="{StaticResource Detail}" Margin="0,0,0,10" />

                        <CheckBox Content="Gamma" IsChecked="{Binding OverrideGamma}" Margin="0,0,0,6"
                                  AutomationProperties.Name="Override gamma" AutomationProperties.AutomationId="MediaOverrideGamma" />
                        <UniformGrid Columns="2" Margin="0,0,-8,12" IsEnabled="{Binding OverrideGamma}">
                            <RadioButton Style="{StaticResource ModeButton}" MinHeight="40" GroupName="MediaGamma" IsChecked="{Binding IsGamma22}"
                                         AutomationProperties.Name="Media gamma 2.2" AutomationProperties.AutomationId="MediaGamma22">
                                <TextBlock Style="{StaticResource ModeLabel}" Text="2.2" />
                            </RadioButton>
                            <RadioButton Style="{StaticResource ModeButton}" MinHeight="40" GroupName="MediaGamma" IsChecked="{Binding IsGamma24}"
                                         AutomationProperties.Name="Media gamma 2.4" AutomationProperties.AutomationId="MediaGamma24">
                                <TextBlock Style="{StaticResource ModeLabel}" Text="2.4" />
                            </RadioButton>
                        </UniformGrid>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BrightnessText}" Style="{StaticResource Caption}"
                                       AutomationProperties.AutomationId="MediaBrightnessText" />
                            <CheckBox Content="Brightness" IsChecked="{Binding OverrideBrightness}"
                                      AutomationProperties.Name="Override brightness" AutomationProperties.AutomationId="MediaOverrideBrightness" />
                        </DockPanel>
                        <Slider Minimum="10" Maximum="100" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding Brightness, Delay=150}" IsEnabled="{Binding OverrideBrightness}" Margin="0,4,0,10"
                                AutomationProperties.Name="Media brightness" AutomationProperties.AutomationId="MediaBrightness" />

                        <DockPanel>
                            <TextBlock Text="Applies to" Style="{StaticResource Caption}" Margin="0,0,12,0" />
                            <ComboBox ItemsSource="{Binding DisplayChoices}" SelectedItem="{Binding AppliesTo}" DisplayMemberPath="Label"
                                      HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="Applies to" AutomationProperties.AutomationId="MediaAppliesTo" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Status}" Style="{StaticResource Detail}" Margin="4,0,4,8"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="Status" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}" Padding="16,10,12,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE7E8;" Command="{Binding ExitCommand}"
                            ToolTip="Exit Gloam" AutomationProperties.Name="Exit" AutomationProperties.AutomationId="Exit" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xEBE8;" Command="{Binding ExportDiagnosticsCommand}"
                            ToolTip="Export diagnostics (logs, settings and display details, for a bug report)"
                            AutomationProperties.Name="Export diagnostics" AutomationProperties.AutomationId="ExportDiagnostics" />
                    <Button DockPanel.Dock="Right" Content="{Binding Update.ActionText}" Command="{Binding Update.ActCommand}" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="Update" />
                    <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="StartWithWindows" />
                </DockPanel>
                <TextBlock Text="{Binding Update.Status}" Style="{StaticResource Detail}" Margin="0,8,0,0"
                           Visibility="{Binding Update.HasStatus, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="UpdateStatus" />
                <ScrollViewer MaxHeight="120" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Update.HasNotes, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Update.Notes}" Style="{StaticResource Detail}" AutomationProperties.AutomationId="UpdateNotes" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</Window>
